<rxui:ReactiveWindow  x:TypeArguments="viewModels:WpfReactiveUiDemoAppMainWindowViewModel "
                      xmlns:rxui="http://reactiveui.net" 
                      x:Class="WpfReactiveUiDemoApp.MainWindow"
   
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:viewModels="clr-namespace:WpfReactiveUiDemoApp.ViewModels"
                      xmlns:controls="clr-namespace:Bodoconsult.App.Wpf.ReactiveUI.Controls;assembly=Bodoconsult.App.Wpf.ReactiveUI"
                      Title="ReactiveUI.Routing" Height="360" Width="620">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="80*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <controls:MenuControl x:Name="MainMenu"/>
        </StackPanel>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="50*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <rxui:RoutedViewHost Grid.Column="0" x:Name="MenuRegion"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch" />
            <rxui:RoutedViewHost Grid.Column="1" x:Name="DocumentRegion"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch" />
        </Grid>


        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15">
            <Button x:Name="GoNextButton" Content="Go to first" />
            <Button x:Name="GoBackButton" Content="Go back" Margin="5 0 0 0" />
            <Button x:Name="GoNewWindowButton" Content="Go to new window" Margin="5 0 0 0" />
            <Button x:Name="GoNewWindowInstance2Button" Content="Go to new window" Margin="5 0 0 0" />
        </StackPanel>
    </Grid>
</rxui:ReactiveWindow>

