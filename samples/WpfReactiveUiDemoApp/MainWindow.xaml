<rxui:ReactiveWindow  x:TypeArguments="viewModels:WpfReactiveUiDemoAppMainWindowViewModel "
                      xmlns:rxui="http://reactiveui.net" 
                      x:Class="WpfReactiveUiDemoApp.MainWindow"
   
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:interfaces="clr-namespace:Bodoconsult.App.Wpf.ReactiveUI.Interfaces;assembly=Bodoconsult.App.Wpf.ReactiveUI"
                      xmlns:viewModels="clr-namespace:WpfReactiveUiDemoApp.ViewModels"
                      Title="ReactiveUI.Routing" Height="360" Width="620">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <rxui:RoutedViewHost 
            Grid.Row="0" 
            x:Name="DocumentRegion"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15">
            <Button x:Name="GoNextButton" Content="Go to first" />
            <Button x:Name="GoBackButton" Content="Go back" Margin="5 0 0 0" />
        </StackPanel>
    </Grid>
</rxui:ReactiveWindow>

