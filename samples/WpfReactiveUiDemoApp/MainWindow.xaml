<rxui:ReactiveWindow x:Class="WpfReactiveUiDemoApp.MainWindow"
                     xmlns:rxui="http://reactiveui.net"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     x:TypeArguments="viewModels:MainWindowViewModel"
                     xmlns:viewModels="clr-namespace:Bodoconsult.App.Wpf.ReactiveUI.AppStarter.ViewModels;assembly=Bodoconsult.App.Wpf.ReactiveUI"
                     mc:Ignorable="d"
                     Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <rxui:RoutedViewHost Grid.Row="0" x:Name="DocumentRegion" HorizontalContentAlignment = "Stretch" VerticalContentAlignment="Stretch"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15">
            <Button x:Name="GoView1Button" Content="Go to view 1"/>
            <Button x:Name="GoView2Button" Content="Go to view 2" Margin="5 0 0 0" />
        </StackPanel>
    </Grid>
</rxui:ReactiveWindow>
