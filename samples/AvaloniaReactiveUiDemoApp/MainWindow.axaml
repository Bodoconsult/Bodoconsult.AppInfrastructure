<rxui:ReactiveWindow  x:TypeArguments="viewModels:AvaloniaReactiveUiDemoAppMainWindowViewModel "
                      xmlns:rxui="http://reactiveui.net" 
                      x:Class="AvaloniaReactiveUiDemoApp.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:viewModels="clr-namespace:AvaloniaReactiveUiDemoApp.ViewModels"
                      xmlns:controls="clr-namespace:Bodoconsult.App.Avalonia.ReactiveUI.Controls;assembly=Bodoconsult.App.Avalonia.ReactiveUI"
                      xmlns:controls1="https://github.com/avaloniaui"
                      xmlns:avaloniaReactiveUiDemoApp="clr-namespace:AvaloniaReactiveUiDemoApp"
                      Title="ReactiveUI.Routing" Height="360" Width="620">

    <controls1:DockPanel>
        <controls:MenuControl x:Name="MainMenu" controls1:DockPanel.Dock="Top" />

        <controls1:StackPanel Orientation="Horizontal" Margin="15" controls1:DockPanel.Dock="Bottom" Background="BlueViolet" Height="50">
            <controls1:Button x:Name="GoNextButton" Content="Go to first" />
            <controls1:Button x:Name="GoBackButton" Content="Go back" Margin="5 0 0 0" />
            <controls1:Button x:Name="GoNewWindowButton" Content="Go to new window" Margin="5 0 0 0" />
            <controls1:Button x:Name="GoNewWindowInstance2Button" Content="Go to new window" Margin="5 0 0 0" />
        </controls1:StackPanel>

        <controls1:Grid Background="Red">
            <controls1:Grid.ColumnDefinitions>
                <controls1:ColumnDefinition Width="50*"></controls1:ColumnDefinition>
                <controls1:ColumnDefinition Width="50*"></controls1:ColumnDefinition>
            </controls1:Grid.ColumnDefinitions>
            <rxui:RoutedViewHost controls1:Grid.Column="0" x:Name="MenuRegion"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" />
            <rxui:RoutedViewHost controls1:Grid.Column="1" x:Name="DocumentRegion"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" />
        </controls1:Grid>

    </controls1:DockPanel>

</rxui:ReactiveWindow>

