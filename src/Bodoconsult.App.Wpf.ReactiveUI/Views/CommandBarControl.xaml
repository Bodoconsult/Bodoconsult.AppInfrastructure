<UserControl x:Class="Bodoconsult.App.Wpf.ReactiveUI.Views.CommandBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models1="clr-namespace:Bodoconsult.Wpf.Application.Models;assembly=Bodoconsult.Wpf.Application"
             xmlns:models="clr-namespace:Bodoconsult.App.Wpf.ReactiveUI.Models"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources >
        <models1:SharedResourceDictionary Source="/Bodoconsult.Wpf.Base;component/Resources/Styling/LookAndFeel.xaml" />
    </UserControl.Resources>

    <Grid>

        <ListBox ItemsSource="{ Binding Buttons}" Background="{DynamicResource SkinMainMenuCommandBarBrush01}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:CommandBarButton}">
                    <Button Command="{Binding Command}" Style="{StaticResource AccentedSquareButtonStyle}" Margin="10 10 10 10">
                        <StackPanel>
                            <Image Name="icon" Source="{Binding ImageUri}"></Image>
                            <Label Content="{ Binding Name}"></Label>
                        </StackPanel>
                    </Button>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ImageUri}" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Source" Value="{x:Null}"/>
                        </DataTrigger>

                    </DataTemplate.Triggers>
               </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>



    </Grid>
</UserControl>
