<Window x:Class="Bodoconsult.App.Wpf.ReactiveUI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="LoginWindow" Height="300" Width="500"
   WindowStartupLocation="CenterScreen"
   AllowsTransparency="True"
   Background="Transparent"
   WindowStyle="None"
   SizeToContent="WidthAndHeight"
   FocusManager.FocusedElement=
          "{Binding ElementName=TxtUserName}"
       
        >

    <Border CornerRadius="10"
                            BorderBrush="Gray"
                            BorderThickness="3"
                            Background="{ Binding LoginData.Background}"
                            Margin="24"
                            Padding="15">
        <Border.Effect>
            <DropShadowEffect Color="Gray"
                                  Opacity=".50"
                                  ShadowDepth="16" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="200*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="3">
                <Image Name="ImgKey"
                       Width="50"
                       Height="50"
                         Margin="8"
                         Source="/Bodoconsult.Wpf.Base;component/Resources/Styling/BitmapGraphics/Assets/LogonImage.png">
                    <Image.Effect>
                        <DropShadowEffect Color="Gray"
                        Opacity=".50"
                        ShadowDepth="8" />
                    </Image.Effect>
                </Image>
            </StackPanel>

            <Label Grid.Column="1"
       Grid.Row="0"
       Grid.ColumnSpan="2"
       FontSize="18"
       Margin="10" Content="{ Binding LoginData.TitleLabel }" />


            <Label Grid.Column="1" Grid.Row="1"  Content="{ Binding LoginData.UserNameLabel }" />
            <TextBox Grid.Column="2"
                     Margin ="0 0 0 5"
         Grid.Row="1"
         ToolTip="{ Binding LoginData.UserNameTooltip }"
         Name="TxtUserName"
                     Text="{ Binding LoginData.UserName }"/>

            <Label Grid.Column="1" Grid.Row="2" Content="{ Binding LoginData.PasswordLabel }" />

            <PasswordBox Grid.Column="2"
             Grid.Row="2"
             ToolTip="{ Binding LoginData.PasswordTooltip }"
             Name="TxtPassword"/>


            <StackPanel Grid.Column="2"
            Grid.Row="3"
            Margin="10"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
                <Button Name="BtnCancel"
                  IsCancel="True"
                        Padding="25 15 25 15"
                  Content="{ Binding LoginData.CancelButtonLabel }"
                  Click="BtnCancelClick">

                    <Button.Effect>
                        <DropShadowEffect Color="Gray"
                        Opacity=".50"
                        ShadowDepth="8" />
                    </Button.Effect>
                </Button>
                <Button Name="BtnLogin"
                        Margin="25 0 0 0"
                        Padding="25 15 25 15"
                  IsDefault="True"
                  Content="{ Binding LoginData.LoginButtonLabel }"
                  Click="BtnLoginClick">
                    <Button.Effect>
                        <DropShadowEffect Color="Gray"
                        Opacity=".50"
                        ShadowDepth="8" />
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>

    </Border>
    <!--ShowInTaskBar="False"-->


</Window>

