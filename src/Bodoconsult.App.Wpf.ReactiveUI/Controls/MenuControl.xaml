<UserControl x:Class="Bodoconsult.App.Wpf.ReactiveUI.Controls.MenuControl"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:viewModels="clr-namespace:Bodoconsult.App.Wpf.ReactiveUI.ViewModels"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d"
          d:DesignHeight="100" d:DesignWidth="300"
          d:DataContext="{d:DesignInstance Type=viewModels:MenuControlViewModel, IsDesignTimeCreatable=True}">
    <!--<UserControl.DataContext>
        <viewModels:MenuControlViewModel/>
    </UserControl.DataContext>-->
    <Grid>
        <Menu x:Name="LocalMenu" DockPanel.Dock="Top" Background="{Binding Path=BackgroundBrush}">
        </Menu>
    </Grid>
</UserControl>