<UserControl x:Class="Bodoconsult.App.Wpf.ReactiveUI.Controls.ContextMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Bodoconsult.App.Wpf.ReactiveUI.ViewModels"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DesignHeight="100" d:DesignWidth="300"
                d:DataContext="{d:DesignInstance Type=viewModels:ContextMenuControlViewModel, IsDesignTimeCreatable=True}">
    <!--<UserControl.DataContext>
        <viewModels:ContextMenuControlViewModel/>
    </UserControl.DataContext>-->

    <Grid>
        <ContextMenu x:Name="ContextMenu" DockPanel.Dock="Top" ItemsSource="{Binding Path=MenuItems}" Background="{Binding Path=BackgroundBrush}">
        </ContextMenu>
    </Grid>
</UserControl>