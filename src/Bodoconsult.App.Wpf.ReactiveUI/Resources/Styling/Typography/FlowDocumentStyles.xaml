<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:models="clr-namespace:Bodoconsult.App.Wpf.Models;assembly=Bodoconsult.App.Wpf">

    <Style x:Key="Standard">
        <Setter Property="TextBlock.FontFamily" Value="Aptos" />
        <Setter Property="TextBlock.FontSize" Value="11" />
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FigureText" BasedOn="{StaticResource Standard}">
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="TextBlock.FontSize" Value="9" />
        <Setter Property="TextBlock.Margin" Value="0 3 0 3" />
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
        <Setter Property="TextBlock.FontStyle" Value="Italic" />
        <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
    </Style>


    <Style x:Key="Headline1" BasedOn="{StaticResource Standard}">
        <Setter Property="TextBlock.FontFamily" Value="Aptos Black" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="TextBlock.FontSize" Value="16" />
        <Setter Property="TextBlock.Margin" Value="10" />
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Headline2" BasedOn="{StaticResource Standard}">
        <Setter Property="TextBlock.FontFamily" Value="Aptos Black" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="TextBlock.FontSize" Value="14" />
        <Setter Property="TextBlock.Margin" Value="0 15 0 5" />
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Headline3" BasedOn="{StaticResource Standard}">
        <Setter Property="TextBlock.FontFamily" Value="Aptos Black" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="TextBlock.FontSize" Value="16" />
        <Setter Property="TextBlock.Margin" Value="0 10 0 5" />
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
    </Style>


    <Style x:Key="Headline4" BasedOn="{StaticResource Standard}">
        <Setter Property="TextBlock.FontFamily" Value="Aptos Black" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="TextBlock.FontSize" Value="16" />
        <Setter Property="TextBlock.Margin" Value="0 5 0 3" />
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
    </Style>

</models:SharedResourceDictionary>