<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:models="clr-namespace:Bodoconsult.App.Wpf.Models;assembly=Bodoconsult.App.Wpf">
    <Style x:Key="InputFormStackPanelStyle" TargetType="{x:Type StackPanel}" >
        <Setter Property="Margin" Value="{ DynamicResource FormInputThickness }"></Setter>
        <Setter Property="Orientation" Value="Horizontal"></Setter>

    </Style>

    <Style x:Key="InputFormButtonStackPanelStyle" TargetType="{x:Type StackPanel}" >
        <Setter Property="Margin" Value="{ DynamicResource FormInputThickness }"></Setter>
        <Setter Property="Orientation" Value="Horizontal"></Setter>

    </Style>
</models:SharedResourceDictionary>