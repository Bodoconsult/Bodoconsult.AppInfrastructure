<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:models="clr-namespace:Bodoconsult.App.Wpf.Models;assembly=Bodoconsult.App.Wpf">

    <models:SharedResourceDictionary.MergedDictionaries>
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/Typography/Typography.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/BrushesColors/Brushes.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/Styles/FrameworkElement.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/ControlTemplates/Templates.xaml" />
    </models:SharedResourceDictionary.MergedDictionaries>

    <!--Default textbox style-->
    <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="Background" Value="{ DynamicResource InputBackgroundBrush01 }" />
        <Setter Property="Foreground" Value="{ DynamicResource InputForegroundBrush01 }" />
        <Setter Property="FontSize" Value="{StaticResource Level4FontSize}" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontWeight" Value="{StaticResource NormalFontWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="InputFormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
        <Setter Property="Margin" Value="{ DynamicResource FormInputThickness }" />
        <Setter Property="Padding" Value="5 0 5 0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="MaxWidth" Value="1200"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{ StaticResource RoundedCornerBaseControlTemplate}" />

        <!--<Style.Triggers>
            <Trigger Property="Width" Value="Auto">
                <Setter Property="MaxWidth" Value="500"/>
            </Trigger>
            <Trigger Property="Height" Value="Auto">
                <Setter Property="MaxHeight" Value="30"/>
            </Trigger>
        </Style.Triggers>-->
    </Style>


</models:SharedResourceDictionary>