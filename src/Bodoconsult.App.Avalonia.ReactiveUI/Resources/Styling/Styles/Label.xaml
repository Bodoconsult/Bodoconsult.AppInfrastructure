<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="clr-namespace:Bodoconsult.App.Avalonia"
                          xmlns:models="clr-namespace:Bodoconsult.App.Avalonia.Models;assembly=Bodoconsult.App.Avalonia">

    <models:SharedResourceDictionary.MergedDictionaries>
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Avalonia.ReactiveUI;component/Resources/Styling/BrushesColors/Colors.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Avalonia.ReactiveUI;component/Resources/Styling/BrushesColors/Brushes.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Avalonia.ReactiveUI;component/Resources/Styling/Typography/Typography.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Avalonia.ReactiveUI;component/Resources/Styling/Styles/FrameworkElement.xaml" />
    </models:SharedResourceDictionary.MergedDictionaries>

    <Style x:Key="LabelStyle" TargetType="Label" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="Background" Value="{ DynamicResource LabelBackgroundBrush01 }" />
        <Setter Property="Foreground" Value="{DynamicResource LabelForegroundBrush01 }" />
        <Setter Property="FontSize" Value="{StaticResource Level4FontSize}" />
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontWeight" Value="{StaticResource NormalFontWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="InputFormLabelStyle" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Margin" Value="{ DynamicResource FormInputThickness }" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        
    </Style>

    <Style x:Key="InputFormLabelTopStyle" TargetType="Label" BasedOn="{StaticResource InputFormLabelStyle}">
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style x:Key="ListBoxTemplateLabelStyle" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ DynamicResource InputForegroundBrush01 }" />
    </Style>

    

    <Style x:Key="InputFormSmallLabelStyle" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Margin" Value="{ DynamicResource FormInputSmallThickness }" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="0" />
        
    </Style>

    <Style x:Key="InputFormImageHeaderLabelStyle" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="FontSize" Value="{StaticResource Level3FontSize}" />
        <Setter Property="Foreground" Value="Black"></Setter>
    </Style>

    <Style x:Key="HeaderLabelStyle01" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <!--<Setter Property="Padding" Value="0 5 0 0" />-->
        <Setter Property="FontSize" Value="{StaticResource Level1FontSize }" />
        <Setter Property="FontWeight" Value="{StaticResource BoldFontWeight}" />

    </Style>

    <Style x:Key="HeaderLabelStyle02" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Padding" Value="0 4 0 0" />
        <Setter Property="FontSize" Value="{StaticResource Level2FontSize }" />
        <Setter Property="FontWeight" Value="{StaticResource BoldFontWeight}" />

    </Style>

    <Style x:Key="HeaderLabelStyle03" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Padding" Value="0 3 0 0" />
        <Setter Property="FontSize" Value="{StaticResource Level3FontSize }" />
        <Setter Property="FontWeight" Value="{StaticResource BoldFontWeight}" />

    </Style>

    <Style x:Key="HeaderLabelStyle04" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Padding" Value="0 2 0 0" />
        <Setter Property="FontWeight" Value="{StaticResource BoldFontWeight}" />
    </Style>

</models:SharedResourceDictionary>