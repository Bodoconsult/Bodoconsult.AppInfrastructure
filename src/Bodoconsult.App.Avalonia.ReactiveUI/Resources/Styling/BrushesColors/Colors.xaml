<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:models="clr-namespace:Bodoconsult.App.Avalonia.Models;assembly=Bodoconsult.App.Avalonia">
    
    
    
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="BlackColor">#000000</Color>
    <Color x:Key="TransparentColor">#00FFFFFF</Color>

    <!-- Background of normal windows-->
    <Color x:Key="BackgroundColor01">#FFF5F5DC</Color>
    
    <!-- Background of dialog windows-->
    <Color x:Key="BackgroundColor02">#FFF5F5DC</Color>

    <!-- Background of buttons-->
    <Color x:Key="BackgroundColor03">#FFFFAA</Color>

    <!-- Background of buttons-->
    <Color x:Key="MainTitleColor01">Orange</Color>

    <Color x:Key="ButtonForegroundColor01">Black</Color>
    <Color x:Key="ButtonForegroundColor02">Orange</Color>

    <!-- Colors for a command bar buttons-->
    <Color x:Key="CommandBarButtonBackgroundColor">#FFF4F4DC</Color>
    <Color x:Key="CommandBarButtonForegroundColor">#000000</Color>
    <Color x:Key="CommandBarButtonBorderColor">#000000</Color>
    <Color x:Key="CommandBarButtonMouseOverBackgroundColor">Aqua</Color>

    <Color x:Key="Gray01Color">#FFFFAA</Color>
    <Color x:Key="Gray02Color">#FFFFFF</Color>



</models:SharedResourceDictionary>