<UserControl x:Class="Bodoconsult.App.Wpf.ReactiveUI.Views.MainWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:regions="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="90*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <ContentControl x:Name="MainWindowMenuBarRegion"
                            regions:RegionManager.RegionName="MainWindowMenuBarRegion"
                            VerticalContentAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"></ColumnDefinition>
                <ColumnDefinition Width="75*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="0 0 0 0">
                <ContentControl x:Name="MainWindowCommandBarRegion"
                            regions:RegionManager.RegionName="MainWindowCommandBarRegion"
                            VerticalContentAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" />
            </Border>

            <Border Grid.Column="1" Padding="10 0 10 0">
                <ScrollViewer>
                    <ContentControl x:Name="MainWindowDocumentRegion"
                            regions:RegionManager.RegionName="MainWindowDocumentRegion"
                            VerticalContentAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.CanContentScroll="True" 
                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </ScrollViewer>

            </Border>

        </Grid>





    </Grid>
</UserControl>
