<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:models="clr-namespace:Bodoconsult.App.Wpf.Models;assembly=Bodoconsult.App.Wpf">

    <models:SharedResourceDictionary.MergedDictionaries>
        <models:SharedResourceDictionary Source="pack://application:,,,/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/Typography/Typography.xaml" />
    </models:SharedResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultErrorTemplate">
        <!--<DockPanel>
            <TextBlock
                DockPanel.Dock="Left"
                Foreground="Red"
                Text="{Binding ElementName=Adorner1, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"></TextBlock>
            <Border BorderBrush="Red" BorderThickness="1" Padding="1">
                <AdornedElementPlaceholder Name="Adorner1" />
            </Border>         
        </DockPanel>-->

        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                <Grid Width="12" Height="12">
                    <Ellipse Width="12" Height="12" 
                        Fill="Red" HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                     
                     ></Ellipse>
                    <TextBlock Foreground="White" FontWeight="Heavy" 
                        FontSize="8" HorizontalAlignment="Center" 
                        VerticalAlignment="Center" TextAlignment="Center"
                       ToolTip="{Binding ElementName=ErrorAdorner, 
                       Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                       >X</TextBlock>
                </Grid>
                <TextBlock Foreground="Red" FontSize="{ StaticResource Level5FontSize }" Margin="2,0,0,0" 
                   Text="{Binding ElementName=ErrorAdorner, 
                   Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                   ></TextBlock>
            </StackPanel>

            <Border BorderBrush="Red" BorderThickness="1" Padding="0">
                <AdornedElementPlaceholder x:Name="ErrorAdorner" ></AdornedElementPlaceholder>
            </Border>
        </DockPanel>
    </ControlTemplate>


    <ControlTemplate x:Key="BlackButton" TargetType="{x:Type Button}">
        <Border BorderBrush="White" BorderThickness="1" CornerRadius="3">
            <Border BorderBrush="DarkGray" BorderThickness="1" CornerRadius="3">
                <Grid Name="ButtonGrid">
                    <Rectangle Name="ButtonRect">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Gray" />
                                <GradientStop Offset="0.49" Color="DimGray" />
                                <GradientStop Offset="0.5" Color="DimGray" />
                                <GradientStop Offset="1" Color="Black" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" />
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <!-- Bei Mausbewegung über den Button ... -->
            <Trigger Property="IsMouseOver" Value="True">
                <!-- Buttonhintergrund heller darstellen -->
                <Setter Property="Fill" TargetName="ButtonRect">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Silver" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <!-- Leuchteffekt -->
                <Setter Property="BitmapEffect">
                    <Setter.Value>
                        <OuterGlowBitmapEffect GlowColor="White" GlowSize="5" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Fill" TargetName="ButtonRect" Value="#FF000000" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RoundedCornerBaseControlTemplate" TargetType="{x:Type TextBoxBase }">
        <Border Background="{TemplateBinding Background}" 
                x:Name="Bd" BorderBrush="Black"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
            <ScrollViewer Name="PART_ContentHost" 
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" 
                          BorderThickness="0" 
                          Background="Transparent" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" TargetName="Bd"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
            <!--<Trigger Property="Width" Value="Auto">
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="MaxWidth" Value="1200"/>
            </Trigger>
            <Trigger Property="Height" Value="Auto">
                <Setter Property="MinHeight" Value="35"/>
                <Setter Property="MaxHeight" Value="40"/>
            </Trigger>-->
        </ControlTemplate.Triggers>
    </ControlTemplate>



</models:SharedResourceDictionary>