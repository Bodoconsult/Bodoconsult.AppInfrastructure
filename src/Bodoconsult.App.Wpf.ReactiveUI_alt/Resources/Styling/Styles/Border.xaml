<models:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:models="clr-namespace:Bodoconsult.App.Wpf.Models;assembly=Bodoconsult.App.Wpf">

    <models:SharedResourceDictionary.MergedDictionaries>
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/BrushesColors/Brushes.xaml" />
        <models:SharedResourceDictionary Source="/Bodoconsult.App.Wpf.ReactiveUI;component/Resources/Styling/Styles/FrameworkElement.xaml" />
    </models:SharedResourceDictionary.MergedDictionaries>

    <Style x:Key="SampleBorderStyle" TargetType="Border" BasedOn="{StaticResource FrameworkElementWithoutOpacityStyle}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="false">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:.2"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:.2"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListBoxItemBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="BorderThickness" Value="0 0 0 1"></Setter>
        <Setter Property="BorderBrush" Value="{ DynamicResource SkinListBoxDividerBorderBrush01 }"></Setter>
        <Setter Property="Background" Value="Gray" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- Buttonhintergrund heller darstellen -->
                <Setter Property="Background" Value="{ DynamicResource SkinListBoxMouseOverBorderBrush01}" />
            </Trigger>

            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                <Setter Property="Background" Value="Gray" />
            </Trigger>

            <Trigger Property="ItemsControl.AlternationIndex" Value="21">
                <Setter Property="Background" Value="LightGray" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <Style x:Key="InputFormBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="BorderBrush" Value="Transparent"></Setter>
        <Setter Property="Margin" Value="{ DynamicResource FormInputThickness }"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>


    <Style x:Key="InputFormInputAreaBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ DynamicResource HighlightBrush}" />
        <Setter Property="Margin" Value="{ DynamicResource FormInputAreaThickness }"/>
        <Setter Property="Background" Value="{ DynamicResource SkinMainInputAreaBrush}" />
        <Setter Property="CornerRadius" Value="5"></Setter>
        <Setter Property="Padding" Value="5"></Setter>
    </Style>
    
    <Style x:Key="InputFormInputCommandBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ DynamicResource SkinMainInputAreaBrush}" />
        <Setter Property="Margin" Value="{ DynamicResource FormInputCommandThickness }"/>
        <Setter Property="Background" Value="{ DynamicResource HighlightBrush}" />
        <Setter Property="CornerRadius" Value="5"></Setter>
        <Setter Property="Padding" Value="5"></Setter>
    </Style>

    <Style x:Key="MainTitleBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ DynamicResource SkinMainInputAreaBrush}" />
        <Setter Property="Margin" Value="0 0 0 3"/>
        <Setter Property="Background" Value="Orange" />
        <Setter Property="CornerRadius" Value="5"></Setter>
        <Setter Property="Padding" Value="3 0 3 0"></Setter>
    </Style>

    <Style x:Key="InputFormImageBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="Margin" Value="{ DynamicResource FormInputThickness }"></Setter>
        <Setter Property="Background" Value="White"></Setter>
        <Setter Property="Padding" Value="3 3 3 3"></Setter>
        <Setter Property="MaxHeight" Value="400"></Setter>
        <Setter Property="CornerRadius" Value="5"></Setter>
    </Style>

