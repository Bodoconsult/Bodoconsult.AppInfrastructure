<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.17763</TargetFramework>

		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Handler\**" />
		<Compile Remove="Model\**" />
		<EmbeddedResource Remove="Handler\**" />
		<EmbeddedResource Remove="Model\**" />
		<None Remove="Handler\**" />
		<None Remove="Model\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="UnitTestMetaDataHandler.cs" />
		<Compile Remove="UnitTestSqlMailUserAccessAllDatabasesExecuter.cs" />
		<Compile Remove="UnitTestSqlMailUserAccessSingleDatabaseExecuter.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="appSettings.json" />
		<None Remove="TestData\job.cjson" />
		<None Remove="TestData\job.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\apps\JobExecuter\JobExecuter.Dal\Templates\MarkdownFile.txt" Link="Templates\MarkdownFile.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\apps\JobExecuter\JobExecuter.Dal\Templates\HtmlFile.txt" Link="Templates\HtmlFile.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\apps\JobExecuter\JobExecuter.Dal\Templates\HtmlMail.txt" Link="Templates\HtmlMail.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\apps\JobExecuter\JobExecuter.Dal\Templates\printer.css" Link="Templates\printer.css">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appSettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Templates\XmlDocumentation.xslt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="TestData\job.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="log4net" Version="3.5.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<!--<PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.7" />-->
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\apps\JobExecuter\JobExecuter.Base\JobExecuter.Base.csproj" />
	  <ProjectReference Include="..\..\apps\JobExecuter\JobExecuter.Dal\JobExecuter.Dal.csproj" />
	  <ProjectReference Include="..\..\apps\JobExecuter\JobExecuter.GpoPlugIn\JobExecuter.GpoPlugIn.csproj" />
	  <ProjectReference Include="..\..\apps\JobExecuter\JobExecuter\JobExecuter.csproj" />
	  <ProjectReference Include="..\..\src\Bodoconsult.Test\Bodoconsult.Test.csproj" />
	</ItemGroup>

</Project>
